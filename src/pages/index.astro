---
import Layout from '../layouts/Layout.astro';
import { Technologies } from '../components/Technologies';
import { ProjectsSection } from '../components/ProjectsSection';
import { portfolioData } from '../config/portfolio';
import { Footer } from'../components/Footer';

const { profile, socials, experience } = portfolioData;
---

<Layout title={`${profile.name} | ${profile.role}`}>
  
  <!-- HERO SECTION CINEMÁTICO ASIMÉTRICO -->
  <section class="relative min-h-[95vh] flex flex-col justify-between px-6 md:px-12 max-w-7xl mx-auto z-20 pt-32 pb-16">
    <div></div>

    <div class="space-y-10 max-w-5xl">
      <!-- Tag Minimalista de Midu-->
      <div id="hero-tag" class="inline-flex items-center gap-3 px-4 py-1.5 rounded-full bg-white/[0.02] border border-white/5 opacity-0 transform translate-y-4">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-neutral-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span>
        </span>
        <span class="text-[10px] font-mono uppercase tracking-widest text-neutral-400">{profile.location}</span>
      </div>
      
      <!-- Máscara de Texto Monumental -->
      <h1 class="text-6xl sm:text-8xl md:text-[7.5rem] font-display font-bold tracking-tighter leading-[0.85] text-reveal-mask">
        <span id="hero-title-1" class="block text-neutral-700 opacity-0 transform translate-y-32">{profile.firstName}</span>
        <span id="hero-title-2" class="block text-transparent bg-clip-text bg-linear-to-b from-white via-neutral-200 to-neutral-500 opacity-0 transform translate-y-32 delay-100">
          {profile.lastName}
        </span>
      </h1>
      
      <!-- Subtexto con Jerarquía Visual Refinada -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 pt-4">
        <p id="hero-desc" class="text-md md:text-xl text-neutral-400 md:col-span-7 font-sans font-light leading-relaxed opacity-0 transform translate-y-4">
          {profile.subrole}. <span class="text-neutral-600 font-normal">{profile.biography}</span>
        </p>
        
        <!-- CTAs Integrados al Flujo Visual -->
        <div id="hero-ctas" class="md:col-span-5 flex flex-row md:justify-end items-center gap-6 opacity-0 transform translate-y-4">
          <a href="#proyectos" class="text-xs font-mono tracking-widest text-white uppercase border-b border-white/30 pb-1 hover:border-white transition-colors duration-300">
            EXPLORAR TRABAJOS ↓
          </a>
          <a href="#contacto" class="px-5 py-2.5 text-xs font-mono tracking-widest bg-white text-black rounded-full hover:bg-neutral-200 transition-all duration-500 premium-interactive">
            HABLEMOS
          </a>
        </div>
      </div>
    </div>

    <!-- Indicador de Scroll Perimetral -->
    <div id="hero-scroll-indicator" class="flex justify-between items-center text-[10px] font-mono tracking-widest text-neutral-600 uppercase pt-16 opacity-0">
      <span>© 2026 INDEX</span>
      <div class="flex items-center gap-2">
        <span class="w-12 h-[1px] bg-neutral-800"></span>
        <span>SCROLL TO VIEW</span>
      </div>
    </div>
  </section>

  <!-- SECCIÓN TRADICIONAL COMPACTADA CON ESPACIO NEGATIVO -->
  <section id="sobre-mi" class="py-48 px-6 md:px-12 max-w-7xl mx-auto relative z-20 grid grid-cols-1 lg:grid-cols-12 gap-16">
    <div class="lg:col-span-5 space-y-8">
      <p class="text-[10px] font-mono tracking-widest text-neutral-500 uppercase">// SOBRE MI</p>
<h2 class="text-3xl md:text-4xl font-display font-medium text-white tracking-tight leading-tight">
  Un solo motor, múltiples plataformas.
</h2>
<p class="text-neutral-400 leading-relaxed font-light text-sm">
  Me especializo en construir la lógica y las APIs que conectan el servidor con aplicaciones web y móviles. Mi enfoque está en estructurar bases de datos eficientes y escribir código limpio bajo buenas prácticas, asegurando que la información fluya de forma rápida, segura y consistente sin importar desde qué dispositivo se conecte el usuario.
</p>
    </div>
    
    <div class="lg:col-span-7 space-y-16 relative border-l border-white/5 pl-8 ml-2">
      {experience.map((exp) => (
        <div class="reveal-timeline relative space-y-3">
          <div class="absolute -left-[37px] top-2 h-1.5 w-1.5 rounded-full bg-neutral-500 border border-[#030303] box-content"></div>
          <span class="text-[10px] font-mono text-neutral-600 tracking-wider">{exp.period}</span>
          <div class="flex items-baseline justify-between flex-wrap gap-2">
            <h3 class="text-lg font-medium text-neutral-200">{exp.role}</h3>
            <span class="text-xs font-mono text-neutral-500">{exp.company}</span>
          </div>
          <ul class="space-y-2 pt-1">
            {exp.description.map(item => (
              <li class="text-xs text-neutral-500 font-light leading-relaxed">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <Technologies client:load />
  <ProjectsSection client:load />
  
  <!-- Queda este, no tocas más -->
  <!-- CONTACTO REFINADO INTERACTIVO -->
  <section id="contacto" class="py-48 px-6 max-w-3xl mx-auto text-center relative z-20">
    <p class="text-[10px] font-mono tracking-widest text-neutral-500 uppercase mb-4">// CONECTAR</p>
    <h2 class="text-4xl md:text-6xl font-display font-bold tracking-tighter text-white mb-8">Diseñemos el futuro.</h2>
    
    <form class="space-y-6 text-left glass-panel p-10 rounded-2xl border border-white/[0.03]" action="https://formspree.io/f/your-id" method="POST">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="space-y-2">
          <label class="text-[10px] font-mono text-neutral-500 uppercase tracking-widest" for="name">Nombre completo</label>
          <input required class="w-full bg-white/[0.01] border border-white/5 rounded-lg px-4 py-3.5 text-sm text-white focus:outline-hidden focus:border-neutral-400 transition-colors duration-300" id="name" name="name" type="text" />
        </div>
        <div class="space-y-2">
          <label class="text-[10px] font-mono text-neutral-500 uppercase tracking-widest" for="email">Dirección de Email</label>
          <input required class="w-full bg-white/[0.01] border border-white/5 rounded-lg px-4 py-3.5 text-sm text-white focus:outline-hidden focus:border-neutral-400 transition-colors duration-300" id="email" name="email" type="email" />
        </div>
      </div>
      <div class="space-y-2">
        <label class="text-[10px] font-mono text-neutral-500 uppercase tracking-widest" for="message">Mensaje</label>
        <textarea required rows="5" class="w-full bg-white/[0.01] border border-white/5 rounded-lg px-4 py-3.5 text-sm text-white focus:outline-hidden focus:border-neutral-400 transition-colors duration-300 resize-none" id="message" name="message"></textarea>
      </div>
      <button type="submit" class="w-full py-4 text-xs font-mono tracking-widest bg-white text-black rounded-lg hover:bg-neutral-200 transition-all duration-500 font-bold cursor-pointer">
        ENVIAR MENSAJE
      </button>
    </form>

    <div class="flex justify-center gap-8 mt-16 text-[10px] font-mono tracking-widest text-neutral-600">
      <a href={socials.github} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors duration-300">GITHUB</a>
      <a href={socials.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors duration-300">LINKEDIN</a>
      <a href={socials.whatsapp} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors duration-300">WHATSAPP</a>
    </div>
  </section>

  <Footer />

</Layout>

<!-- ANIMACIÓN GSAP PRECISIÓN AWWARDS -->
<script>
  import { gsap } from 'gsap';

  window.addEventListener('DOMContentLoaded', () => {
    const tl = gsap.timeline({ defaults: { ease: 'cubic-bezier(0.16, 1, 0.3, 1)', duration: 1.6 } });

    // Coreografía Cinematográfica de entrada
    tl.to('#hero-tag', { opacity: 1, y: 0, duration: 1 })
      .to('#hero-title-1', { opacity: 1, y: 0 }, '-=1.2')
      .to('#hero-title-2', { opacity: 1, y: 0 }, '-=1.4')
      .to('#hero-desc', { opacity: 1, y: 0 }, '-=1.3')
      .to('#hero-ctas', { opacity: 1, y: 0 }, '-=1.4')
      .to('#hero-scroll-indicator', { opacity: 1, duration: 1 }, '-=1.2');

      // Ver si la dejo o la saco
      // Reveal elegante para la línea de tiempo
    gsap.utils.toArray('.reveal-timeline').forEach((element: any) => {
      gsap.from(element, {
        opacity: 0,
        y: 20,
        duration: 1.4,
        scrollTrigger: {
          trigger: element,
          start: 'top 90%',
          toggleActions: 'play none none none',
        }
      });
    });
  });
</script>