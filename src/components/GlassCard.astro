---
interface Props {
  class?: string;
  href?: string;
}

const { class: className = '', href } = Astro.props;
const Element = href ? 'a' : 'div';
---

<Element
  {href}
  class={`relative group rounded-2xl bg-neutral-950/40 p-6 backdrop-blur-xl border border-white/10 shadow-2xl transition-all duration-300 hover:border-purple-500/30 hover:bg-neutral-900/50 hover:shadow-purple-500/5 ${className}`}
>
  <!-- Brillo sutil superior en hover -->
  <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-white/[0.07] to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
  
  <slot />
</Element>