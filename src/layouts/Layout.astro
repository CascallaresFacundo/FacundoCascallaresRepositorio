---
import '../styles/global.css';
import { portfolioData } from '../config/portfolio';
import { Navbar } from '../components/Navbar';

interface Props {
  title: string;
}

const { title } = Astro.props;
const { profile } = portfolioData;

// Configuración de variables dinámicas para SEO y Open Graph
const siteDescription = `${profile.role} - ${profile.subrole}. Especializado en construir la lógica de servidores, APIs eficientes y arquitecturas de bases de datos robustas.`;
const siteUrl = "https://facundocascallares.vercel.app/"; 
const ogImageUrl = `${siteUrl}/og-image.jpg`;  
---

<!DOCTYPE html>
<html lang="es" class="bg-[#050505] text-[#f5f5f7] antialiased selection:bg-white/20 selection:text-white">
  <head>
    <!-- METADATOS CRÍTICOS Y ESTRUCTURALES-->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO ESTÁNDAR Y INDEXACIÓN ========================================== -->
    <title>{title}</title>
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={siteUrl} />
    <meta name="robots" content="index, follow" />
    
    <!-- OPEN GRAPH / FACEBOOK / LINKEDIN / WHATSAPP -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_AR" />

    <!-- TWITTER CARDS ========================================== -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={siteUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- FUENTES TIPOGRÁFICAS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
  </head>
  <body class="overflow-x-hidden font-sans">
    
    <!-- Textura fílmica estática global -->
    <div class="pointer-events-none fixed inset-0 z-50 h-full w-full opacity-[0.025] bg-[url('/noise.svg')]"></div>

    <!-- Iluminación ambiental difusa de fondo -->
    <div class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
      <div class="absolute -top-[40%] -left-[20%] h-[80vw] w-[80vw] rounded-full bg-radial from-purple-500/10 to-transparent blur-[120px]"></div>
      <div class="absolute top-[40%] -right-[30%] h-[70vw] w-[70vw] rounded-full bg-radial from-blue-500/5 to-transparent blur-[140px]"></div>
    </div>

    <!-- Barra fija de progreso de lectura superior -->
    <div id="scroll-progress" class="fixed top-0 left-0 z-50 h-[2px] w-0 bg-linear-to-r from-purple-500 via-violet-400 to-white transition-all duration-75 ease-out"></div>

    <!-- NAVBAR FLOTANTE INTERACTIVO FIJO (Fuera del wrapper de scroll) -->
    <Navbar client:load />

    <!-- Contenedor dinámico animado por el motor de scroll -->
    <div id="smooth-wrapper" class="relative z-10">
      <slot />
    </div>

    <!-- SCRIPTS DE CLIENTE (SMOOTH SCROLL & GSAP) -->
    <script>
      import Lenis from '@studio-freight/lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // Inicialización de Lenis Smooth Scroll
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: 'vertical',
        gestureOrientation: 'vertical',
        smoothWheel: true,
        wheelMultiplier: 1,
        touchMultiplier: 1.5,
      });

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);

      // Sincronizar ScrollTrigger con Lenis
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });
      gsap.ticker.lagSmoothing(0);

      // Animación de la barra de progreso de lectura
      gsap.to('#scroll-progress', {
        width: '100%',
        ease: 'none',
        scrollTrigger: {
          trigger: 'body',
          start: 'top top',
          end: 'bottom bottom',
          scrub: true,
        },
      });
    </script>
  </body>
</html>